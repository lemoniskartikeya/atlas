# Atlas backend configuration.
#
# Copy to `.env` in this directory and fill in what you need. Every value is
# optional — Atlas runs fully local with none of them set; each one switches on
# a feature that talks to something outside this machine.
#
# `.env` is gitignored. NEVER commit real credentials, and never put any of
# these into the desktop app: it only ever talks to this backend, and this
# backend is the only thing that holds a secret.
#
# Settings are read with the ATLAS_ prefix (pydantic-settings), so the variable
# name is ATLAS_<field> in upper case.

# ----------------------------------------------------------------- email OTP
# Transactional email for sign-in codes. Without these, requesting a code
# returns a clear "not configured" error rather than pretending to send one.
#
# Two ways to send. Configure either one; "auto" (the default) uses whichever
# is filled in, preferring SMTP. Set ATLAS_EMAIL_PROVIDER to pin one.
# ATLAS_EMAIL_PROVIDER=auto        # auto | smtp | resend

# --- Option 1: SMTP (free, recommended) --------------------------------------
# Sends through an ordinary mailbox you already own. No paid plan, no domain,
# no DNS. With Gmail:
#
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:      https://myaccount.google.com/apppasswords
#    (a 16-character code — your normal Google password will NOT work, and
#    the App Passwords page only appears once 2-Step Verification is on)
# 3. Fill in the three values below and restart Atlas.
#
# Gmail sends up to ~500 messages a day this way, which is far more than a
# personal install needs. Other hosts work the same: Outlook is
# smtp-mail.outlook.com:587, Fastmail smtp.fastmail.com:465.
ATLAS_SMTP_HOST=smtp.gmail.com
ATLAS_SMTP_USER=you@gmail.com
ATLAS_SMTP_PASSWORD=
# 587 uses STARTTLS (the usual case); 465 is implicit TLS and ignores the flag.
# ATLAS_SMTP_PORT=587
# ATLAS_SMTP_STARTTLS=true

# --- Option 2: Resend (HTTPS API) --------------------------------------------
# Free to a point, but it only delivers to addresses other than your own once
# you have verified a domain you control.
#
# 1. Create an account at https://resend.com
# 2. Add and verify your sending domain (Domains -> Add Domain, then add the
#    DNS records it shows you)
# 3. Create an API key at https://resend.com/api-keys
# ATLAS_RESEND_API_KEY=
# Required by Resend, and must be on the domain you verified. With SMTP this is
# optional: leave it blank and mail is sent from ATLAS_SMTP_USER, which is what
# most mailboxes require anyway (Gmail silently rewrites anything else).
# ATLAS_EMAIL_FROM=no-reply@yourdomain.com

# The display name recipients see. Blank sends from the bare address.
ATLAS_EMAIL_FROM_NAME=Atlas

# How many codes one address may request per hour, and the quiet period
# enforced between consecutive requests.
# ATLAS_OTP_PER_EMAIL_PER_HOUR=5
# ATLAS_OTP_RESEND_COOLDOWN_SECONDS=60
# Ceiling per calling machine, so one client cannot farm codes by rotating
# through many addresses.
# ATLAS_OTP_PER_IP_PER_HOUR=15

# Answer "no such account" and "already registered" identically, hiding which
# addresses have accounts. Off by default because the sign-in screen tells the
# user which of the two applies.
# ATLAS_OTP_NEUTRAL_RESPONSES=false

# DEVELOPMENT ONLY. Returns the code in the API response so you can test
# without a mailbox. Ignored unless ATLAS_ENV is exactly "development" —
# setting this on a deployed instance does nothing.
# ATLAS_OTP_DEV_ECHO=false

# --------------------------------------------------------------- Google login
# Create an OAuth client (type: Desktop app) at
# https://console.cloud.google.com/apis/credentials and register the redirect
# URI that Settings -> Sign in with Google shows you.
ATLAS_GOOGLE_CLIENT_ID=
# Only needed if you registered a "Web application" client.
ATLAS_GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------ AI coach
# One key per provider; set only the one you use. Groq, Gemini and OpenRouter
# all have free tiers. Leave all of them blank to keep the coach fully offline.
ATLAS_COACH_PROVIDER=anthropic
# Blank uses that provider's default model.
ATLAS_COACH_MODEL=
ATLAS_ANTHROPIC_API_KEY=
ATLAS_GROQ_API_KEY=
ATLAS_GEMINI_API_KEY=
ATLAS_OPENROUTER_API_KEY=

# ------------------------------------------------------------------- runtime
# Defaults to a SQLite file in this directory (or %APPDATA%\Atlas when packaged).
# ATLAS_DATABASE_URL=sqlite:///./atlas.db
# ATLAS_ENV=development
# ATLAS_DEBUG=true
# ATLAS_PORT=8000
