# Vite `--mode tauri` build (used by `npm run tauri build`).
# A packaged desktop app is served from the tauri:// origin, so relative /api
# doesn't reach the backend — point it at the local FastAPI server directly.
# (Dev via `npm run tauri dev` uses Vite's proxy instead and needs none of this.)
VITE_API_BASE=http://127.0.0.1:8000
